# Dependencies
node_modules/

# Runtime data stores — money/account system of record, NEVER commit these.
# Covers both the production store dir (gateway cwd) and any store written when
# the server is run from the repo root during local dev.
backend/gateway/data/
/data/
*.wallets.json
*.auth.json

# Secrets — belong in /etc/nichefinder.env on the host, never in the repo
.env
*.env
!.env.example

# Logs & OS cruft
*.log
.DS_Store
